# Copy to .env.local for development, and set the same values in Vercel's
# project settings for production. .env.local is gitignored — never commit it.

# --- Mentoring booking -------------------------------------------------------
# Leave BOOKING_LIVE unset (or anything other than "true") and the mentoring
# section shows "Booking opens soon" instead of a pay button that cannot work.
NEXT_PUBLIC_BOOKING_LIVE=false
NEXT_PUBLIC_CALENDLY_URL=

# --- Razorpay ----------------------------------------------------------------
# The key ID is public and may be sent to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# The secret must stay server-side. Do NOT rename this to NEXT_PUBLIC_* —
# every NEXT_PUBLIC_ variable is inlined into the JavaScript bundle that is
# downloaded by every visitor, which would publish the secret to the world.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
