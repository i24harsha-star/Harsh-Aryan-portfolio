# Copy to .env.local for development, and set the same values in Vercel's
# project settings for production. .env.local is gitignored — never commit it.

# --- Mentoring booking -------------------------------------------------------
# The Razorpay Payment Page URL for a 1:1 session. Leave EMPTY and the mentoring
# section shows "Booking opens soon" rather than a pay button that cannot work.
#
# Flow: this page collects Rs 499, then Razorpay redirects to the Calendly link
# configured inside the Payment Page itself ("Redirect to your website").
# Nothing secret here — it is a public URL — so NEXT_PUBLIC_ is correct.
NEXT_PUBLIC_PAYMENT_URL=

# --- Razorpay ----------------------------------------------------------------
# Only needed if the site ever creates orders itself rather than using a hosted
# Payment Page. The key ID is public; the secret must stay server-side.
# Do NOT rename the secret to NEXT_PUBLIC_* — every NEXT_PUBLIC_ variable is
# inlined into the JavaScript downloaded by every visitor.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
