# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template holds no secrets and documents which variables are required.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright CLI scratch (screenshots, snapshots, console logs)
.playwright-cli/

# Third-party skills installed via `npx skills add`. Restored with
# `npx skills experimental_install` from skills-lock.json, which IS committed.
# Not vendored into the repo: they arrived without a licence file, so
# redistributing them here would not be ours to do.
.claude/skills/*
!.claude/skills/web-interface-guidelines/
